# Copy to .env (never commit real values). Paper-only defaults.
# Full matrix: docs/ops/CONFIG-MATRIX.md. Stack: TS + Go only.
ENV=dev
HUMAN_APPROVAL_REQUIRED=true
FALLBACK_ORDERS_ENABLED=false
# Go watcher
GO_PORT=8080
REDIS_URL=redis://localhost:6379
TOOBIT_WS_URL=wss://example.invalid/verify-required
# Telegram userbot (gotd/td) — personal-account signal ingestion.
# Secrets: export in shell / secret manager, never commit values.
# TG_APP_ID=placeholder-from-my-telegram-org
# TG_APP_HASH=placeholder-from-my-telegram-org
# TG_PHONE=placeholder-international-format
# TG_CODE=placeholder-first-login-only
# TG_PASSWORD=placeholder-if-2fa-enabled
# TG_ALLOW_BOTS=FalconToobitBot
# TG_SESSION_FILE=./tg-session.json
# TG_EMBED=0
# Workers local (wrangler dev vars; secrets via `wrangler secret`, never here)
# TOOBIT_API_KEY=placeholder-set-via-secret-store
# TOOBIT_API_SECRET=placeholder-set-via-secret-store

# ── Live trading (docs/21, ADR-013) — NOT part of the MVP ────────────────────
# Everything below MUST stay commented. `LIVE_TRADING_ENABLED` must not exist in
# any environment until the docs/21 §21.9 gate is signed by two humans, and the
# repo's own tripwires enforce that: scripts/paper-gate.mjs refuses a PASS when
# any LIVE_* key exists, and scripts/paper-cycle.mjs / scripts/chaos.mjs refuse
# to run when LIVE_TRADING_ENABLED is set. Flipping these without the gate is a
# review-blocking defect (docs/13 §13.8).
# ENV=live
# LIVE_TRADING_ENABLED=true
# TOOBIT_RECV_WINDOW=5000
# POSITION_MODE=one-way        # one-way | hedge  (must match the account; Q-15)
# MARGIN_TYPE=cross            # cross | isolated  (must match the account; Q-15)

