# Copy to .env (never commit real values). Paper-only defaults.
# Full matrix: docs/ops/CONFIG-MATRIX.md. Stack: TS + Go only.
ENV=dev
HUMAN_APPROVAL_REQUIRED=true
FALLBACK_ORDERS_ENABLED=false
# Go watcher
GO_PORT=8080
REDIS_URL=redis://localhost:6379
TOOBIT_WS_URL=wss://example.invalid/verify-required
# Workers local (wrangler dev vars; secrets via `wrangler secret`, never here)
# TOOBIT_API_KEY=placeholder-set-via-secret-store
# TOOBIT_API_SECRET=placeholder-set-via-secret-store

