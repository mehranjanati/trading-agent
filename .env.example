# Copy to .env (never commit real values). Paper-only defaults.
# Full matrix: docs/ops/CONFIG-MATRIX.md. Stack: TS + Go only.
ENV=dev
HUMAN_APPROVAL_REQUIRED=true
FALLBACK_ORDERS_ENABLED=false
# Go watcher
GO_PORT=8080
REDIS_URL=redis://localhost:6379
TOOBIT_WS_URL=wss://example.invalid/verify-required
# Telegram userbot (gotd/td) — personal-account signal ingestion.
# Secrets: export in shell / secret manager, never commit values.
# TG_APP_ID=placeholder-from-my-telegram-org
# TG_APP_HASH=placeholder-from-my-telegram-org
# TG_PHONE=placeholder-international-format
# TG_CODE=placeholder-first-login-only
# TG_PASSWORD=placeholder-if-2fa-enabled
# TG_ALLOW_BOTS=FalconToobitBot
# TG_SESSION_FILE=./tg-session.json
# TG_EMBED=0
# Workers local (wrangler dev vars; secrets via `wrangler secret`, never here)
# TOOBIT_API_KEY=placeholder-set-via-secret-store
# TOOBIT_API_SECRET=placeholder-set-via-secret-store

