.env
.env.*
!.env.example
node_modules/
dist/
.build/
.svelte-kit/
*.local
coverage/
bin/
*.log
.DS_Store
wrangler/.cache
.dev.vars

# wrangler local dev state (build artifacts / local sqlite; never commit)
.wrangler/
workers/.wrangler/

# Go command binaries built in-place (e.g. `go build ./cmd/restart-drill`)
/go-watcher/restart-drill
# Telegram userbot session (MTProto auth keys — secrets, never commit)
go-watcher/tg-session.json
*.session.json
go-watcher/session/
# Docker prebuilt watcher (cross-compiled; rebuilt by docker compose build)
/go-watcher/docker/
# Local toolchains (Go + sqlite3 CLI) and their module/build caches: sandbox or
# laptop tooling, never repo content.
/.toolchain/
/.gopath/
/.gocache/
# NOTE: go-watcher/strategies/samples/*.wasm ARE tracked on purpose — the
# registry pins them by filename and the Dockerfile copies them into the
# image, so a checkout must ship the exact artifacts the registry names.
# Rebuild any entry with: make strategy-build SRC=<dir> ID=<id> VERSION=<x.y.z>
