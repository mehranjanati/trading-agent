{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "signal.order_block.v1",
  "type": "object",
  "required": ["symbol", "side", "zone_low", "zone_high"],
  "additionalProperties": false,
  "properties": {
    "symbol": { "type": "string", "pattern": "^[A-Z]{2,12}USDT$" },
    "side": { "enum": ["BUY", "SELL"] },
    "zone_low": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
    "zone_high": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
    "mitigated": { "type": "boolean" }
  }
}
