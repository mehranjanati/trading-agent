{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "signal.regime.v1",
  "type": "object",
  "required": ["symbol", "regime"],
  "additionalProperties": false,
  "properties": {
    "symbol": { "type": "string", "pattern": "^[A-Z]{2,12}USDT$" },
    "regime": { "enum": ["TREND", "RANGE", "BREAKOUT", "CHOP"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "volatility_band": { "type": "string", "minLength": 1 }
  }
}
